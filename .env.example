# GatherBuy AI - Environment Configuration

# Supabase (PostgreSQL Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API (AI Procurement Agent)
# Recommended: gemini-1.5-flash or gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# PayPal Developer Platform (Sandbox)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD

# Application Settings
# Set to 'true' to allow exploring the application with full mock data and fallback capabilities
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
